#!/usr/bin/env python3
# voiceink - Voice to text transcription
# SPDX-License-Identifier: GPL-3.0-or-later

import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

locale.bindtextdomain('voiceink', localedir)
locale.textdomain('voiceink')
gettext.install('voiceink', localedir)

if __name__ == '__main__':
    import gi
    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'voiceink.gresource'))
    resource._register()

    from voiceink import main
    sys.exit(main.main())
